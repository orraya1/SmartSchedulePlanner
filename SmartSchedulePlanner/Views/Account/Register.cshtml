@model SmartSchedulePlanner.ViewModels.RegisterViewModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <title>

        Register

    </title>

    <link rel="stylesheet" href="~/css/login.css" />

</head>

<body>

    <div class="login-card">

        <h2>

            Register

        </h2>

        <form asp-action="Register" method="post">

            <input asp-for="FullName"
                   class="textbox"
                   placeholder="Full Name" />

            <input asp-for="Email"
                   class="textbox"
                   placeholder="Email" />

            <input asp-for="Password"
                   type="password"
                   class="textbox"
                   placeholder="Password" />

            <input asp-for="ConfirmPassword"
                   type="password"
                   class="textbox"
                   placeholder="Confirm Password" />

            <button class="login-btn">

                Register

            </button>

            <br />

            <br />

            <a asp-action="Login">

                Back to Login

            </a>

        </form>

    </div>

</body>

</html>