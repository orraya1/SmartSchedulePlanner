@model IEnumerable<SmartSchedulePlanner.Models.Schedule>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var schedules = Model
        .OrderBy(x => x.StudyDate)
        .ThenBy(x => x.StartTime)
        .ToList();

    var activityId = (int)ViewBag.ActivityId;

    var fitness = ViewBag.Fitness;

    var isScheduleConfirmed =
    ViewBag.IsScheduleConfirmed ?? false;

    var progressBySchedule =
        (Dictionary<int, SmartSchedulePlanner.Models.StudyProgress>)
        (ViewBag.ProgressBySchedule
            ?? new Dictionary<int, SmartSchedulePlanner.Models.StudyProgress>());

    int startHour = schedules.Any()
        ? (int)Math.Floor(
            schedules.Min(x => x.StartTime.TotalHours))
        : 8;

    int endHour = schedules.Any()
        ? (int)Math.Ceiling(
            schedules.Max(x => x.EndTime.TotalHours))
        : 18;

    if (endHour <= startHour)
        endHour = startHour + 1;

    var firstDate = schedules.Any()
        ? schedules.Min(x => x.StudyDate).Date
        : DateTime.Today;

    int dayDiff =
        (7 + (firstDate.DayOfWeek - DayOfWeek.Monday)) % 7;

    var weekStart =
        firstDate.AddDays(-dayDiff);

    var days = Enumerable.Range(0, 7)
        .Select(i => weekStart.AddDays(i))
        .ToList();

    var colors = new[]
    {
        "#DDE9D5",
        "#DDECF5",
        "#F5E8D5",
        "#F5DCDC",
        "#EADFF2",
        "#DDE8E8",
        "#F1E4D2"
    };
}

<style>

    .schedule-page {
        padding: 30px;
    }

    /* =========================
           HEADER
           ========================= */

    .schedule-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .schedule-title h2 {
        margin: 0;
        font-size: 28px;
        font-weight: 600;
        color: #333;
    }

    .schedule-title p {
        margin: 7px 0 0;
        color: #888;
        font-size: 14px;
    }

    .header-actions {
        display: flex;
        gap: 10px;
    }

    .confirm-schedule-btn {
        background: #dcebd6;
        color: #56704e;
        border: none;
        cursor: pointer;
    }

        .confirm-schedule-btn:hover {
            background: #cfe2c7;
        }

    .schedule-confirmed {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 9px 16px;
        border-radius: 9px;
        background: #edf5e9;
        color: #5d7a55;
        font-size: 13px;
    }

    .header-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 9px 16px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 13px;
        transition: .2s;
    }

    .btn-back {
        background: #f3f3f3;
        color: #555;
    }

        .btn-back:hover {
            background: #e8e8e8;
        }


    /* =========================
           SUMMARY
           ========================= */

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: white;
        border-radius: 14px;
        padding: 18px 20px;
        box-shadow: 0 3px 15px rgba(0,0,0,.05);
    }

    .summary-label {
        font-size: 12px;
        color: #999;
        margin-bottom: 7px;
    }

    .summary-value {
        font-size: 23px;
        font-weight: 600;
        color: #444;
    }

    .summary-description {
        margin-top: 5px;
        font-size: 11px;
        color: #aaa;
    }


    /* =========================
           CALENDAR
           ========================= */

    .calendar-card {
        background: white;
        border-radius: 18px;
        padding: 20px;
        box-shadow: 0 4px 18px rgba(0,0,0,.06);
        overflow-x: auto;
    }

    .calendar {
        min-width: 900px;
    }

    .calendar-header {
        display: grid;
        grid-template-columns: 90px repeat(7, 1fr);
        border-bottom: 1px solid #eee;
    }

    .calendar-header-empty {
        background: #fafafa;
        border-right: 1px solid #eee;
    }

    .day-header {
        text-align: center;
        padding: 12px 5px;
        background: #fafafa;
        border-right: 1px solid #eee;
    }

    .day-name {
        font-size: 12px;
        color: #888;
    }

    .day-date {
        margin-top: 4px;
        font-size: 16px;
        font-weight: 600;
        color: #444;
    }

    .calendar-body {
        display: grid;
        grid-template-columns: 90px repeat(7, 1fr);
    }


    /* =========================
           TIME COLUMN
           ========================= */

    .time-column {
        border-right: 1px solid #eee;
    }

    .time-slot {
        height: 70px;
        box-sizing: border-box;
        border-bottom: 1px solid #eee;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding-top: 10px;
        font-size: 10px;
        color: #999;
    }


    /* =========================
           DAY COLUMN
           ========================= */

    .day-column {
        position: relative;
        border-right: 1px solid #eee;
    }

    .time-cell {
        height: 70px;
        box-sizing: border-box;
        border-bottom: 1px solid #eee;
        position: relative;
        background: #fff;
    }

        .time-cell.lunch {
            background: #fafafa;
        }

    .lunch-label {
        font-size: 9px;
        color: #bbb;
        text-align: center;
        padding-top: 27px;
    }


    /* =========================
           STUDY CARD
           ========================= */

    .study-card {
        position: absolute;
        left: 5px;
        right: 5px;
        top: 5px;
        bottom: 5px;
        border-radius: 10px;
        padding: 8px;
        box-sizing: border-box;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,.06);
    }

    .study-card-header {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
        box-sizing: border-box;
        padding-right: 43px;
    }

        .study-card-header strong {
            display: block;
            width: 100%;
            min-width: 0;
            font-size: 13px;
            font-weight: 600;
            color: #444;
            line-height: 1.3;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }


    /* =========================
           PROGRESS BUTTON
           ========================= */

    .study-card .progress-btn {
        position: absolute;
        top: 0;
        right: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 3px 6px;
        min-width: 36px;
        border-radius: 5px;
        background: rgba(255,255,255,.85);
        color: #555 !important;
        font-size: 8px;
        line-height: 1.2;
        text-decoration: none !important;
        white-space: nowrap;
        z-index: 10;
        box-sizing: border-box;
        cursor: pointer;
        transition: .2s;
    }

        .study-card .progress-btn:hover {
            background: white;
            color: #333 !important;
        }


    /* =========================
           TIME
           ========================= */

    .study-card small {
        display: block;
        margin-top: 3px;
        font-size: 9px;
        color: #777;
    }


    /* =========================
           STATUS + NOTE BUTTON
           ========================= */

    .progress-row {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-top: 5px;
        min-width: 0;
    }

    .progress-status {
        display: inline-flex;
        align-items: center;
        padding: 3px 7px;
        border-radius: 6px;
        font-size: 9px;
        font-weight: 600;
        white-space: nowrap;
    }

    .progress-complete {
        background: #e2f0df;
        color: #55704f;
    }

    .progress-partial {
        background: #f8edcf;
        color: #806d35;
    }

    .progress-none {
        background: #f3dddd;
        color: #8a5555;
    }


    /* =========================
           NOTE BUTTON
           ========================= */

    .note-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 3px 6px;
        border: none;
        border-radius: 6px;
        background: rgba(255,255,255,.75);
        color: #777;
        font-size: 9px;
        line-height: 1.2;
        white-space: nowrap;
        cursor: pointer;
        transition: .2s;
    }

        .note-btn:hover {
            background: white;
            color: #555;
        }


    /* =========================
           FITNESS
           ========================= */

    .fitness-box {
        margin-top: 20px;
        padding: 15px 18px;
        background: #faf8f4;
        border-radius: 12px;
        font-size: 13px;
        color: #666;
    }

    .fitness-value {
        font-weight: 600;
        color: #555;
    }


    /* =========================
           NOTE MODAL
           ========================= */

    .note-modal {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,.35);
        align-items: center;
        justify-content: center;
        padding: 20px;
        box-sizing: border-box;
    }

        .note-modal.show {
            display: flex;
        }

    .note-modal-card {
        width: 100%;
        max-width: 500px;
        background: white;
        border-radius: 16px;
        padding: 24px;
        box-sizing: border-box;
        box-shadow: 0 10px 35px rgba(0,0,0,.15);
        animation: noteModalIn .2s ease;
    }

    .note-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 15px;
    }

    .note-modal-title {
        font-size: 18px;
        font-weight: 600;
        color: #444;
    }

    .note-close {
        width: 30px;
        height: 30px;
        border: none;
        border-radius: 50%;
        background: #f3f3f3;
        color: #666;
        font-size: 18px;
        cursor: pointer;
    }

        .note-close:hover {
            background: #e8e8e8;
        }

    .note-modal-content {
        background: #faf8f4;
        border-radius: 10px;
        padding: 15px;
        font-size: 13px;
        line-height: 1.6;
        color: #555;
        white-space: pre-wrap;
        word-break: break-word;
        max-height: 300px;
        overflow-y: auto;
    }

    @@keyframes noteModalIn {

        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* =========================
           RESPONSIVE
           ========================= */

    @@media (max-width: 900px) {

        .schedule-page {
            padding: 15px;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .schedule-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .header-actions {
            width: 100%;
        }

        .header-btn {
            width: 100%;
        }
    }

</style>


<div class="schedule-page">


    <!-- =========================
         HEADER
         ========================= -->

    <div class="schedule-header">

        <div class="schedule-title">

            <h2>
                ตารางอ่านหนังสือ
            </h2>

            <p>
                ตารางที่สร้างโดย Genetic Algorithm
            </p>

        </div>


        <div class="header-actions">

            @if (isScheduleConfirmed)
            {
                <div class="schedule-confirmed">

                    ✓ ยืนยันแล้ว

                </div>
            }
            else
            {
                <form asp-controller="Schedule"
                      asp-action="ConfirmSchedule"
                      method="post"
                      onsubmit="return confirm('ยืนยันตารางนี้ใช่หรือไม่? หลังจากยืนยันแล้วจะไม่สามารถสร้างตารางใหม่ได้');">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@activityId" />

                    <button type="submit"
                            class="header-btn confirm-schedule-btn">

                        ✓ ยืนยันตาราง

                    </button>

                </form>
            }

            <a href="@Url.Action(
        "Details",
        "StudyActivity",
        new { id = activityId })"
               class="header-btn btn-back">

                ← กลับ

            </a>

        </div>

    </div>


    <!-- =========================
         SUMMARY
         ========================= -->

    <div class="summary-grid">


        <div class="summary-card">

            <div class="summary-label">
                ช่วงเวลา
            </div>

            <div class="summary-value"
                 style="font-size:16px;">

                @weekStart.ToString("dd/MM/yyyy")
                -
                @(weekStart.AddDays(6).ToString("dd/MM/yyyy"))

            </div>

            <div class="summary-description">
                ระยะเวลาของตาราง
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-label">
                Fitness
            </div>

            <div class="summary-value">

                @(fitness ?? "-")

            </div>

        </div>


    </div>


    <!-- =========================
         CALENDAR
         ========================= -->

    <div class="calendar-card">

        <div class="calendar">


            <!-- HEADER -->

            <div class="calendar-header">

                <div class="calendar-header-empty"></div>


                @foreach (var day in days)
                {
                    <div class="day-header">

                        <div class="day-name">

                            @switch (day.DayOfWeek)
                            {
                                case DayOfWeek.Monday:
                                    @:จันทร์
                                    break;

                                case DayOfWeek.Tuesday:
                                    @:อังคาร
                                    break;

                                case DayOfWeek.Wednesday:
                                    @:พุธ
                                    break;

                                case DayOfWeek.Thursday:
                                    @:พฤหัสบดี
                                    break;

                                case DayOfWeek.Friday:
                                    @:ศุกร์
                                    break;

                                case DayOfWeek.Saturday:
                                    @:เสาร์
                                    break;

                                case DayOfWeek.Sunday:
                                    @:อาทิตย์
                                    break;
                            }

                        </div>


                        <div class="day-date">

                            @day.Day

                        </div>

                    </div>
                }

            </div>


            <!-- BODY -->

            <div class="calendar-body">


                <!-- TIME -->

                <div class="time-column">

                    @for (
                    int hour = startHour;
                    hour < endHour;
                    hour++)
                    {
                        <div class="time-slot">

                            @($"{hour:00}:00 - {(hour + 1):00}")

                        </div>
                    }

                </div>


                <!-- DAYS -->
                @foreach (var day in days)
                {

                    <div class="day-column">

                        @for (
                       int hour = startHour;
                       hour < endHour;
                       hour++)
                        {

                            var cellStart =
                            TimeSpan.FromHours(hour);

                            var cellEnd =
                            TimeSpan.FromHours(hour + 1);

                            var schedule =
                            schedules.FirstOrDefault(x =>
                            x.StudyDate.Date == day.Date &&
                            x.StartTime < cellEnd &&
                            x.EndTime > cellStart);


                            <div class="time-cell
                                        @(hour == 12
                                            ? "lunch"
                                            : "")">


                                @if (hour == 12)
                                {
                                    <div class="lunch-label">
                                        พักกลางวัน
                                    </div>
                                }


                                @if (schedule != null)
                                {

                                    var item = schedule;

                                    var color =
                                    colors[
                                    schedules
                                    .IndexOf(item)
                                    % colors.Length
                                    ];


                                    <div class="study-card"
                                         style="background:@color;">

                                        @{
                                            progressBySchedule.TryGetValue(
                                            item.Id,
                                            out var progress);
                                        }


                                        <!-- SUBJECT + BUTTON -->

                                        <div class="study-card-header">

                                            <strong>
                                                @item.SubjectName
                                            </strong>


                                            <a href="@Url.Action(
                                                "Create",
                                                "StudyProgress",
                                                new
                                                {
                                                    scheduleId = item.Id
                                                })"
                                               class="progress-btn">

                                                @(progress == null
                                                    ? "บันทึกผล"
                                                    : "แก้ไขผล")

                                            </a>

                                        </div>


                                        <!-- TIME -->

                                        <small>

                                            @item.StartTime.Hours.ToString("D2"):
                                            @item.StartTime.Minutes.ToString("D2")

                                            -

                                            @item.EndTime.Hours.ToString("D2"):
                                            @item.EndTime.Minutes.ToString("D2")

                                        </small>


                                        <!-- STATUS + NOTE -->
                                        @if (progress != null)
                                        {

                                            <div class="progress-row">


                                                @if (progress.IsCompleted)
                                                {
                                                    <div class="progress-status progress-complete">

                                                        ✓ ทำครบ

                                                    </div>
                                                }
                                                else if (
                                                progress.ProgressPercent > 0)
                                                {
                                                    <div class="progress-status progress-partial">

                                                        ◐ ทำบางส่วน

                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="progress-status progress-none">

                                                        × ไม่ได้อ่าน

                                                    </div>
                                                }


                                                @if (!string.IsNullOrWhiteSpace(
                                               progress.Note))
                                                {
                                                    <button type="button"
                                                            class="note-btn"
                                                            data-note="@progress.Note"
                                                            onclick="showNote(this)">

                                                        📝 Note

                                                    </button>
                                                }

                                            </div>

                                        }

                                    </div>

                                }

                            </div>

                        }

                    </div>

                }

            </div>

        </div>


        <!-- =========================
             FITNESS INFO
             ========================= -->
        @if (fitness != null)
        {
            <div class="fitness-box">

                Fitness ของตารางนี้:

                <span class="fitness-value">
                    @fitness
                </span>

            </div>
        }

    </div>

</div>


<!-- =========================
     NOTE MODAL
     ========================= -->

<div id="noteModal"
     class="note-modal"
     onclick="closeNoteOutside(event)">

    <div class="note-modal-card"
         onclick="event.stopPropagation()">


        <div class="note-modal-header">

            <div class="note-modal-title">

                📝 Note

            </div>


            <button type="button"
                    class="note-close"
                    onclick="closeNote()">

                ×

            </button>

        </div>


        <div id="noteModalContent"
             class="note-modal-content">
        </div>


    </div>

</div>


<script>

    function showNote(button) {

        const note =
            button.getAttribute("data-note") || "";

        document.getElementById("noteModalContent")
            .textContent = note;

        document.getElementById("noteModal")
            .classList.add("show");

    }


    function closeNote() {

        document.getElementById("noteModal")
            .classList.remove("show");

    }


    function closeNoteOutside(event) {

        if (event.target.id === "noteModal") {

            closeNote();

        }

    }


    document.addEventListener(
        "keydown",
        function (event) {

            if (event.key === "Escape") {

                closeNote();

            }

        }
    );

</script>