@model SmartSchedulePlanner.Models.StudyActivity

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>

    .activity-page {
        padding: 25px;
    }

    .activity-header {
        margin-bottom: 25px;
    }

        .activity-header h2 {
            margin: 0;
            font-size: 30px;
            font-weight: 600;
            color: #444;
        }

        .activity-header p {
            margin: 6px 0 0;
            color: #888;
        }

    .delete-container {
        max-width: 600px;
        background: white;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,.05);
    }

    .delete-message {
        padding: 18px;
        background: #f7f7f7;
        border-radius: 10px;
        color: #555;
        margin-bottom: 20px;
        line-height: 1.7;
    }

    .activity-name {
        font-weight: 600;
        color: #444;
    }

    .activity-info {
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px solid #eeeeee;
    }

    .info-row {
        display: flex;
        margin-bottom: 8px;
        font-size: 13px;
    }

    .info-label {
        width: 110px;
        color: #888;
    }

    .info-value {
        color: #555;
    }

    .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 25px;
    }

    .form-btn {
        border-radius: 10px;
        padding: 10px 18px;
        font-size: 13px;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-delete {
        background: #f1f3f1;
        color: #666;
        border: 1px solid #e1e4e1;
    }

        .btn-delete:hover {
            background: #e7eae7;
            color: #444;
        }

    .btn-cancel {
        background: #fff;
        color: #777;
        border: 1px solid #e1e4e1;
    }

        .btn-cancel:hover {
            background: #f7f7f7;
        }

    @@media (max-width: 800px) {

        .activity-page {
            padding: 15px;
        }

        .delete-container {
            max-width: 100%;
        }
    }

</style>


<div class="activity-page">

    <div class="activity-header">

        <h2>
            ลบกิจกรรม
        </h2>

        <p>
            ตรวจสอบข้อมูลก่อนลบกิจกรรม
        </p>

    </div>


    <div class="delete-container">

        <div class="delete-message">

            ต้องการลบกิจกรรม

            <span class="activity-name">
                @Model.ActivityName
            </span>

            ใช่หรือไม่?


            <div class="activity-info">

                <div class="info-row">

                    <span class="info-label">
                        วันที่เริ่ม
                    </span>

                    <span class="info-value">
                        @Model.StartDate.ToShortDateString()
                    </span>

                </div>


                <div class="info-row">

                    <span class="info-label">
                        วันที่สิ้นสุด
                    </span>

                    <span class="info-value">
                        @Model.EndDate.ToShortDateString()
                    </span>

                </div>


                <div class="info-row">

                    <span class="info-label">
                        เวลาอ่าน
                    </span>

                    <span class="info-value">
                        @Model.DailyStartTime - @Model.DailyEndTime
                    </span>

                </div>

            </div>

        </div>


        <form asp-action="Delete"
              method="post">

            <input asp-for="Id"
                   type="hidden" />

            <div class="form-actions">

                <button type="submit"
                        class="form-btn btn-delete">

                    ลบกิจกรรม

                </button>

                <a asp-action="Index"
                   class="form-btn btn-cancel">

                    ยกเลิก

                </a>

            </div>

        </form>

    </div>

</div>