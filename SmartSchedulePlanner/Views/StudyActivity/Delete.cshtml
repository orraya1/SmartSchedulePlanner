@model SmartSchedulePlanner.Models.StudyActivity

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-body">

            <h2 class="text-danger">ลบกิจกรรม</h2>

            <p class="mt-3">
                คุณต้องการลบกิจกรรมนี้หรือไม่?
            </p>

            <div class="mb-3">
                <strong>ชื่อกิจกรรม:</strong>
                @Model.ActivityName
            </div>

            <div class="mb-3">
                <strong>วันที่เริ่ม:</strong>
                @Model.StartDate.ToString("dd/MM/yyyy")
            </div>

            <div class="mb-3">
                <strong>วันที่สิ้นสุด:</strong>
                @Model.EndDate.ToString("dd/MM/yyyy")
            </div>

            <form asp-action="Delete" method="post">

                <input type="hidden" asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger"
                        onclick="return confirm('ยืนยันการลบกิจกรรมนี้หรือไม่?');">
                    ลบกิจกรรม
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    ยกเลิก
                </a>

            </form>

        </div>

    </div>

</div>