@model SmartSchedulePlanner.Models.StudyActivity

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<h2>เพิ่มกิจกรรมการอ่านหนังสือ</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label>ชื่อกิจกรรม</label>
        <input asp-for="ActivityName" class="form-control" />
    </div>

    <div class="mb-3">
        <label>วันที่เริ่ม</label>
        <input asp-for="StartDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label>วันที่สิ้นสุด</label>
        <input asp-for="EndDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label>เวลาเริ่มอ่าน</label>
        <input asp-for="DailyStartTime" type="time" class="form-control" />
    </div>

    <div class="mb-3">
        <label>เวลาเลิกอ่าน</label>
        <input asp-for="DailyEndTime" type="time" class="form-control" />
    </div>

    <button class="btn btn-success">
        บันทึกและไปเพิ่มวิชา
    </button>

</form>