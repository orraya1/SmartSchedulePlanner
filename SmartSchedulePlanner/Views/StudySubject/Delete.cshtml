@model SmartSchedulePlanner.Models.ActivitySubject

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>

    .subject-page {
        padding: 25px;
    }

    .subject-header {
        margin-bottom: 25px;
    }

        .subject-header h2 {
            margin: 0;
            font-size: 30px;
            font-weight: 600;
            color: #444;
        }

        .subject-header p {
            margin: 6px 0 0;
            color: #888;
        }

    .delete-container {
        max-width: 600px;
        background: white;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,.05);
    }

    .delete-message {
        padding: 18px;
        background: #f7f7f7;
        border-radius: 10px;
        color: #555;
        margin-bottom: 20px;
    }

    .subject-name {
        font-weight: 600;
        color: #444;
    }

    .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .form-btn {
        border-radius: 10px;
        padding: 10px 18px;
        font-size: 13px;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-delete {
        background: #f3f3f3;
        color: #666;
        border: 1px solid #e1e1e1;
    }

        .btn-delete:hover {
            background: #e9e9e9;
            color: #444;
        }

    .btn-cancel {
        background: #fff;
        color: #777;
        border: 1px solid #e1e4e1;
    }

        .btn-cancel:hover {
            background: #f7f7f7;
        }

</style>


<div class="subject-page">

    <div class="subject-header">

        <h2>
            ลบรายวิชา
        </h2>

        <p>
            ตรวจสอบข้อมูลก่อนลบรายวิชา
        </p>

    </div>


    <div class="delete-container">

        <div class="delete-message">

            ต้องการลบวิชา

            <span class="subject-name">
                @Model.SubjectName
            </span>

            ใช่หรือไม่?

        </div>


        <form asp-action="Delete"
              method="post">

            <input asp-for="Id"
                   type="hidden" />


            <div class="form-actions">

                <button type="submit"
                        class="form-btn btn-delete">

                    ลบรายวิชา

                </button>


                <a asp-action="Index"
                   asp-route-id="@Model.StudyActivityId"
                   class="form-btn btn-cancel">

                    ยกเลิก

                </a>

            </div>

        </form>

    </div>

</div>