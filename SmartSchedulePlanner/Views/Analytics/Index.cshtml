@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var subjectDistribution =
        ViewBag.SubjectDistribution
        as IEnumerable<dynamic>;

    var totalStudyHours =
        (double)ViewBag.TotalStudyHours;
}

<style>

    .analytics-page {
        padding: 30px;
    }

    .analytics-header {
        background: #ffffff;
        border-radius: 18px;
        padding: 25px 30px;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

        .analytics-header h1 {
            margin: 0 0 8px;
            font-size: 28px;
            color: #333;
        }

        .analytics-header p {
            margin: 0;
            color: #777;
        }

    .analytics-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .analytics-summary-card {
        background: #ffffff;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    .analytics-summary-number {
        font-size: 30px;
        font-weight: 700;
        color: #333;
    }

    .analytics-summary-title {
        margin-top: 5px;
        color: #777;
    }

    .distribution-card {
        background: #ffffff;
        border-radius: 18px;
        padding: 28px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    .distribution-title {
        font-size: 22px;
        font-weight: 700;
        color: #333;
        margin-bottom: 25px;
    }

    .distribution-item {
        margin-bottom: 25px;
    }

    .distribution-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .distribution-subject {
        font-size: 17px;
        font-weight: 600;
        color: #444;
    }

    .distribution-value {
        font-size: 14px;
        color: #777;
    }

    .distribution-bar-background {
        width: 100%;
        height: 14px;
        background: #eeeeee;
        border-radius: 20px;
        overflow: hidden;
    }

    .distribution-bar {
        height: 100%;
        border-radius: 20px;
        background: #A8C69F;
        transition: width 0.4s ease;
    }

    .distribution-info {
        display: flex;
        justify-content: space-between;
        margin-top: 7px;
        font-size: 13px;
        color: #888;
    }

</style>


<div class="analytics-page">

    <!-- Header -->

    <div class="analytics-header">

        <h1>Analytics</h1>

        <p>
            วิเคราะห์การจัดสรรเวลาอ่านหนังสือ
            จากตารางที่ Genetic Algorithm สร้างขึ้น
        </p>

    </div>


    <!-- Summary -->

    <div class="analytics-summary">

        <div class="analytics-summary-card">

            <div class="analytics-summary-number">
                @totalStudyHours.ToString("0.##")h
            </div>

            <div class="analytics-summary-title">
                ชั่วโมงอ่านทั้งหมด
            </div>

        </div>


        <div class="analytics-summary-card">

            <div class="analytics-summary-number">
                @(subjectDistribution?.Count() ?? 0)
            </div>

            <div class="analytics-summary-title">
                วิชาทั้งหมด
            </div>

        </div>

    </div>


    <!-- Subject Distribution -->
    @if (subjectDistribution != null &&
    subjectDistribution.Any())
    {
        <div class="distribution-card">

            <div class="distribution-title">
                การกระจายเวลาอ่านตาม Weight
            </div>


            @foreach (var item in subjectDistribution)
            {
                var percentage =
                (double)item.Percentage;

                var barWidth =
                Math.Min(percentage, 100);


                <div class="distribution-item">

                    <div class="distribution-top">

                        <div class="distribution-subject">
                            @item.SubjectName
                        </div>

                        <div class="distribution-value">

                            @percentage.ToString("0.0")%
                            /
                            @item.Weight%

                        </div>

                    </div>


                    <div class="distribution-bar-background">

                        <div class="distribution-bar"
                             style="
                                width:
                                @barWidth.ToString(
                                    "0.##",
                                    System.Globalization.CultureInfo.InvariantCulture
                                )%;
                                     ">
                        </div>

                    </div>


                    <div class="distribution-info">

                        <span>
                            ได้จริง
                            @item.Hours.ToString("0.##")
                            ชั่วโมง
                        </span>

                        <span>
                            Weight @item.Weight%
                        </span>

                    </div>

                </div>
            }

        </div>
    }

</div>