@model IEnumerable<SmartSchedulePlanner.Models.Schedule>

@using System.Globalization

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var schedules = Model
        .OrderBy(x => x.StudyDate)
        .ThenBy(x => x.StartTime)
        .ToList();

    var today =
        (DateTime)ViewBag.Today;

    var weekStart =
        (DateTime)ViewBag.WeekStart;

    var monthStart =
        (DateTime)ViewBag.MonthStart;

    var todaySchedules =
        (IEnumerable<SmartSchedulePlanner.Models.Schedule>)
        ViewBag.TodaySchedules;

    var weekSchedules =
        (IEnumerable<SmartSchedulePlanner.Models.Schedule>)
        ViewBag.WeekSchedules;

    var monthSchedules =
        (IEnumerable<SmartSchedulePlanner.Models.Schedule>)
        ViewBag.MonthSchedules;

    var days =
        Enumerable.Range(0, 7)
            .Select(i => weekStart.AddDays(i))
            .ToList();

    var firstDayOffset =
        ((int)monthStart.DayOfWeek + 6) % 7;

    var daysInMonth =
        DateTime.DaysInMonth(
            monthStart.Year,
            monthStart.Month);

    var calendarCells =
        firstDayOffset + daysInMonth;

    var totalHours =
        (double)ViewBag.TotalStudyHours;

    var colors = new[]
    {
        "#DDE9D5",
        "#DDECF5",
        "#F5E8D5",
        "#F5DCDC",
        "#EADFF2",
        "#DDE8E8",
        "#F1E4D2"
    };
}

<style>

    body {
        background: #f5f1ea;
    }

    .dashboard {
        padding: 30px;
        color: #555;
    }

    /* HEADER */

    .welcome-card {
        background: #fff;
        border-radius: 22px;
        padding: 30px;
        margin-bottom: 22px;
        box-shadow: 0 4px 18px rgba(0,0,0,.04);
    }

        .welcome-card h1 {
            font-size: 34px;
            margin: 0;
            color: #444;
            font-weight: 500;
        }

        .welcome-card p {
            margin-top: 8px;
            color: #999;
        }

    /* SUMMARY */

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .summary-card {
        border-radius: 18px;
        padding: 22px;
        min-height: 120px;
    }

        .summary-card:nth-child(1) {
            background: #dcebd5;
        }

        .summary-card:nth-child(2) {
            background: #f3dddd;
        }

        .summary-card:nth-child(3) {
            background: #eee2d1;
        }

    .summary-number {
        font-size: 30px;
        font-weight: 600;
        color: #555;
    }

    .summary-title {
        margin-top: 5px;
        color: #777;
    }

    /* TABS */

    .schedule-tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 15px;
    }

    .schedule-tab {
        border: none;
        background: transparent;
        padding: 8px 18px;
        border-radius: 20px;
        color: #777;
        cursor: pointer;
        font-size: 15px;
    }

        .schedule-tab.active {
            background: #e9d9bd;
            color: #555;
        }

    .schedule-panel {
        display: none;
    }

        .schedule-panel.active {
            display: block;
        }

    /* CARD */

    .schedule-card {
        background: #fff;
        border-radius: 20px;
        padding: 22px;
        box-shadow: 0 4px 18px rgba(0,0,0,.04);
    }

        .schedule-card h3 {
            margin-top: 0;
            color: #555;
            font-weight: 500;
        }

    /* TODAY */

    .today-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .today-item {
        display: grid;
        grid-template-columns: 120px 1fr;
        align-items: center;
        padding: 15px;
        border-radius: 12px;
        background: #faf8f4;
    }

    .today-time {
        color: #888;
        font-size: 14px;
    }

    .today-subject {
        font-size: 16px;
        font-weight: 500;
        color: #555;
    }

    /* WEEK */

    .week-calendar {
        display: grid;
        grid-template-columns: 70px repeat(7, 1fr);
        overflow-x: auto;
        min-width: 950px;
    }

    .week-header {
        text-align: center;
        padding: 12px 5px;
        border-bottom: 1px solid #eee;
        font-weight: 600;
    }

        .week-header small {
            display: block;
            color: #aaa;
            margin-top: 4px;
        }

    .time-column {
        color: #999;
    }

    .time-label {
        height: 70px;
        text-align: right;
        padding-right: 8px;
        padding-top: 5px;
        font-size: 12px;
    }

    .week-day {
        position: relative;
        height: 840px;
        border-left: 1px solid #eee;
        background: repeating-linear-gradient( to bottom, transparent 0, transparent 69px, #eeeeee 70px );
    }

    .week-event {
        position: absolute;
        left: 4px;
        right: 4px;
        border-radius: 9px;
        padding: 7px;
        overflow: hidden;
        font-size: 12px;
    }

        .week-event strong {
            display: block;
            color: #555;
        }

        .week-event small {
            color: #777;
        }

    /* MONTH */

    .month-title {
        text-align: center;
        font-size: 20px;
        margin-bottom: 20px;
        color: #666;
    }

    .month-calendar {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 5px;
    }

    .month-day-name {
        text-align: center;
        padding: 10px;
        font-size: 13px;
        color: #999;
    }

    .month-cell {
        min-height: 110px;
        background: #faf9f6;
        border-radius: 10px;
        padding: 8px;
    }

        .month-cell.today {
            border: 2px solid #d8bd91;
        }

    .month-number {
        font-size: 13px;
        color: #777;
        margin-bottom: 5px;
    }

    .month-event {
        padding: 4px 6px;
        border-radius: 6px;
        font-size: 10px;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .empty {
        padding: 50px;
        text-align: center;
        color: #999;
    }

    @@media (max-width: 1200px) {
        .summary-grid

    {
        grid-template-columns: 1fr;
    }

    .dashboard {
        padding: 15px;
    }

    }
</style>


<div class="dashboard">

    <!-- HEADER -->

    <div class="welcome-card">

        <h1>
            Smart Schedule Planner
        </h1>

        <p>
            ตารางกิจกรรมการอ่านหนังสือของคุณ
        </p>

    </div>


    <!-- SUMMARY -->

    <div class="summary-grid">

        <div class="summary-card">

            <div class="summary-number">
                @ViewBag.TotalActivities
            </div>

            <div class="summary-title">
                กิจกรรมทั้งหมด
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-number">
                @ViewBag.TotalSubjects
            </div>

            <div class="summary-title">
                วิชาทั้งหมด
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-number">
                @totalHours.ToString("0.##")h
            </div>

            <div class="summary-title">
                ชั่วโมงอ่านทั้งหมด
            </div>

        </div>

    </div>


    <!-- TABS -->

    <div class="schedule-tabs">

        <button class="schedule-tab active"
                onclick="showSchedule('today', this)">

            รายวัน

        </button>

        <button class="schedule-tab"
                onclick="showSchedule('week', this)">

            รายสัปดาห์

        </button>

        <button class="schedule-tab"
                onclick="showSchedule('month', this)">

            รายเดือน

        </button>

    </div>


    <!-- ================= TODAY ================= -->

    <div id="today"
         class="schedule-panel active">

        <div class="schedule-card">

            <h3>
                ตารางกิจกรรมวันนี้
            </h3>

            <p style="color:#aaa;">
                @today.ToString("dddd dd MMMM yyyy",
                         new CultureInfo("th-TH"))
            </p>


            @if (todaySchedules.Any())
            {
                <div class="today-list">

                    @foreach (var item in todaySchedules)
                    {
                        <div class="today-item">

                            <div class="today-time">

                                @item.StartTime.ToString(@"hh\:mm")
                                -
                                @item.EndTime.ToString(@"hh\:mm")

                            </div>

                            <div class="today-subject">

                                @item.SubjectName

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="empty">

                    วันนี้ยังไม่มีตารางอ่านหนังสือ

                </div>
            }

        </div>

    </div>


    <!-- ================= WEEK ================= -->

    <div id="week"
         class="schedule-panel">

        <div class="schedule-card">

            <h3>
                ตารางกิจกรรมประจำสัปดาห์
            </h3>

            <div style="overflow-x:auto;">

                <div class="week-calendar">

                    <!-- Header -->

                    <div></div>

                    @foreach (var day in days)
                    {
                        <div class="week-header">

                            @day.ToString("ddd")

                            <small>
                                @day.ToString("dd/MM")
                            </small>

                        </div>
                    }


                    <!-- Time -->

                    <div class="time-column">

                        @for (int hour = 6; hour <= 17; hour++)
                        {
                            <div class="time-label">

                                @hour.ToString("00"):00

                            </div>
                        }

                    </div>


                    <!-- Days -->
                    @foreach (var day in days)
                    {
                        <div class="week-day">

                            @{
                                var daySchedules =
                                weekSchedules
                                .Where(x =>
                                x.StudyDate.Date ==
                                day.Date)
                                .ToList();

                                int colorIndex = 0;
                            }

                            @foreach (var item in daySchedules)
                            {
                                double top =
                                (item.StartTime.TotalHours - 6)
                                * 70;

                                double height =
                                (item.EndTime -
                                item.StartTime)
                                .TotalHours * 70;

                                var color =
                                colors[
                                colorIndex %
                                colors.Length
                                ];

                                colorIndex++;

                                <div class="week-event"
                                     style="
                                        top:@top.ToString(
                                            "0.##",
                                            CultureInfo.InvariantCulture)px;

                                        height:@height.ToString(
                                            "0.##",
                                            CultureInfo.InvariantCulture)px;

                                        background:@color;
                                             ">

                                    <strong>
                                        @item.SubjectName
                                    </strong>

                                    <small>

                                        @item.StartTime.ToString(@"hh\:mm")
                                        -
                                        @item.EndTime.ToString(@"hh\:mm")

                                    </small>

                                </div>
                            }

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- ================= MONTH ================= -->

    <div id="month"
         class="schedule-panel">

        <div class="schedule-card">

            <div class="month-title">

                @monthStart.ToString(
                         "MMMM yyyy",
                         new CultureInfo("en-US"))

            </div>


            <div class="month-calendar">

                <div class="month-day-name">Mon</div>
                <div class="month-day-name">Tue</div>
                <div class="month-day-name">Wed</div>
                <div class="month-day-name">Thu</div>
                <div class="month-day-name">Fri</div>
                <div class="month-day-name">Sat</div>
                <div class="month-day-name">Sun</div>


                @for (int i = 0; i < firstDayOffset; i++)
                {
                    <div></div>
                }


                @for (int dayNumber = 1;
                dayNumber <= daysInMonth;
                dayNumber++)
                {
                    var currentDate =
                    new DateTime(
                    monthStart.Year,
                    monthStart.Month,
                    dayNumber);

                    var dayEvents =
                    monthSchedules
                    .Where(x =>
                    x.StudyDate.Date ==
                    currentDate.Date)
                    .ToList();

                    <div class="month-cell
                         @(currentDate.Date == today.Date
                             ? "today"
                             : "")">

                        <div class="month-number">

                            @dayNumber

                        </div>


                        @foreach (var item in dayEvents)
                        {
                            <div class="month-event"
                                 style="
                                    background:
                                    @colors[
                                        item.Id %
                                        colors.Length
                                    ];
                                         ">

                                @item.SubjectName

                                <br />

                                @item.StartTime.ToString(@"hh\:mm")

                            </div>
                        }

                    </div>
                }

            </div>

        </div>

    </div>

</div>


<style>
    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: #ffffff !important;
        background-color: #ffffff !important;
        border: 1px solid #eeeeee;
        border-radius: 18px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
        padding: 25px;
    }

    .summary-number {
        color: #333333 !important;
        font-size: 32px;
        font-weight: 600;
    }

    .summary-title {
        color: #777777 !important;
        font-size: 16px;
        margin-top: 8px;
    }

    @@media (max-width: 900px) {
        .summary-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>

    function showSchedule(type, button) {

        document
            .querySelectorAll(".schedule-panel")
            .forEach(function (panel) {

                panel.classList.remove("active");

            });

        document
            .querySelectorAll(".schedule-tab")
            .forEach(function (tab) {

                tab.classList.remove("active");

            });

        document
            .getElementById(type)
            .classList.add("active");

        button.classList.add("active");
    }

</script>