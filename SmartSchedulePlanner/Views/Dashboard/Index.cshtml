@model IEnumerable<SmartSchedulePlanner.Models.Schedule>

@using System.Globalization

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var schedules = Model
        .OrderBy(x => x.StudyDate)
        .ThenBy(x => x.StartTime)
        .ToList();

    var today =
        (DateTime)ViewBag.Today;

    var previousDay =
        today.AddDays(-1);

    var nextDay =
        today.AddDays(1);

    var weekStart =
        (DateTime)ViewBag.WeekStart;

    var previousWeek =
        weekStart.AddDays(-7);

    var nextWeek =
        weekStart.AddDays(7);

    var monthStart =
        (DateTime)ViewBag.MonthStart;

    var previousMonth =
        monthStart.AddMonths(-1);

    var nextMonth =
        monthStart.AddMonths(1);

    var todaySchedules =
        (IEnumerable<SmartSchedulePlanner.Models.Schedule>)
        ViewBag.TodaySchedules;

    var weekSchedules =
        (IEnumerable<SmartSchedulePlanner.Models.Schedule>)
        ViewBag.WeekSchedules;

    var monthSchedules =
        (IEnumerable<SmartSchedulePlanner.Models.Schedule>)
        ViewBag.MonthSchedules;

    var days =
        Enumerable.Range(0, 7)
            .Select(i => weekStart.AddDays(i))
            .ToList();

    var firstDayOffset =
        ((int)monthStart.DayOfWeek + 6) % 7;

    var daysInMonth =
        DateTime.DaysInMonth(
            monthStart.Year,
            monthStart.Month);

    var totalHours =
        (double)ViewBag.TotalStudyHours;

    int weekStartHour = 6;
    int weekEndHour = 18;

    if (weekSchedules != null && weekSchedules.Any())
    {
        weekStartHour = (int)Math.Floor(
            weekSchedules.Min(x =>
                x.StartTime.TotalHours));

        weekEndHour = (int)Math.Ceiling(
            weekSchedules.Max(x =>
                x.EndTime.TotalHours));
    }

    if (weekEndHour <= weekStartHour)
    {
        weekEndHour = weekStartHour + 1;
    }

    int weekTotalHours =
        weekEndHour - weekStartHour;

    double weekCalendarHeight =
        weekTotalHours * 70;

    var colors = new[]
    {
        "#DDE9D5",
        "#DDECF5",
        "#F5E8D5",
        "#F5DCDC",
        "#EADFF2",
        "#DDE8E8",
        "#F1E4D2"
    };
}

<style>

    .dashboard-page {
        padding: 25px;
    }

    /* =========================
           Header
           ========================= */

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .dashboard-title h2 {
        margin: 0;
        font-size: 30px;
        font-weight: 600;
        color: #444;
    }

    .dashboard-title p {
        margin: 6px 0 0;
        color: #888;
    }

    /* =========================
           Summary Cards
           ========================= */

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: white;
        border-radius: 14px;
        padding: 18px 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,.05);
    }

    .summary-label {
        font-size: 13px;
        color: #888;
        margin-bottom: 7px;
    }

    .summary-value {
        font-size: 25px;
        font-weight: 600;
        color: #444;
    }

    .summary-sub {
        font-size: 12px;
        color: #999;
        margin-top: 3px;
    }

    /* =========================
           Tabs
           ========================= */

    .dashboard-tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 15px;
    }

    .dashboard-tab {
        padding: 9px 16px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 13px;
        color: #777;
        background: #f3f3f3;
        transition: .2s;
    }

        .dashboard-tab:hover {
            background: #e9e9e9;
        }

        .dashboard-tab.active {
            background: #e8def8;
            color: #5f4b8b;
            font-weight: 600;
        }

    /* =========================
           Navigation
           ========================= */

    .calendar-navigation {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: white;
        padding: 13px 18px;
        border-radius: 12px;
        margin-bottom: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,.04);
    }

    .navigation-title {
        font-size: 15px;
        font-weight: 600;
        color: #555;
    }

    .navigation-buttons {
        display: flex;
        gap: 7px;
    }

    .navigation-btn {
        width: 34px;
        height: 34px;
        border: none;
        border-radius: 8px;
        background: #f3f3f3;
        color: #555;
        cursor: pointer;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: .2s;
    }

        .navigation-btn:hover {
            background: #e8e8e8;
        }

    /* =========================
           Calendar
           ========================= */

    .calendar-container {
        background: white;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,.05);
        overflow-x: auto;
    }

    /* =========================
           Week Calendar
           ========================= */

    .week-calendar {
        min-width: 1050px;
    }

    .week-header {
        display: grid;
        grid-template-columns: 75px repeat(7, 1fr);
        border-bottom: 1px solid #ddd;
    }

    .week-header-empty {
        height: 55px;
    }

    .week-day-header {
        height: 55px;
        text-align: center;
        padding-top: 8px;
        box-sizing: border-box;
        font-size: 13px;
        font-weight: 600;
        color: #444;
    }

        .week-day-header small {
            display: block;
            margin-top: 4px;
            color: #999;
            font-weight: 400;
        }

    .week-body {
        display: grid;
        grid-template-columns: 75px repeat(7, 1fr);
    }

    .week-time-column {
        border-right: 1px solid #eee;
    }

    .week-time-label {
        height: 70px;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding-right: 10px;
        border-bottom: 1px solid #eee;
        font-size: 11px;
        color: #888;
        white-space: nowrap;
    }

    .week-day {
        position: relative;
        border-left: 1px solid #eee;
        background: repeating-linear-gradient( to bottom, white 0, white 69px, #eeeeee 69px, #eeeeee 70px );
    }

    /* =========================
           Grouped Activities
           ========================= */

    .activity-group-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 10px;
        margin-bottom: 15px;
    }

    .activity-group-card {
        background: white;
        border-radius: 10px;
        padding: 11px 13px;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
        border-left: 4px solid #ddd;
    }

    .activity-group-name {
        font-size: 12px;
        font-weight: 600;
        color: #555;
        margin-bottom: 5px;
    }

    .activity-group-subjects {
        font-size: 10px;
        color: #888;
        line-height: 1.5;
    }

    .activity-group-hours {
        margin-top: 5px;
        font-size: 10px;
        color: #777;
    }

    /* =========================
           Week Event
           ========================= */

    .week-event {
        position: absolute;
        left: 4px;
        right: 4px;
        box-sizing: border-box;
        border-radius: 10px;
        padding: 9px 10px;
        border: 1px solid rgba(0,0,0,.08);
        overflow: hidden;
        transition: .2s;
    }

        .week-event:hover {
            transform: translateY(-1px);
            box-shadow: 0 3px 8px rgba(0,0,0,.08);
        }

        .week-event strong {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #444;
            line-height: 1.3;
        }

    .week-event-activity {
        font-size: 9px;
        font-weight: 600;
        color: #777;
        margin-bottom: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        .week-event small {
            display: block;
            margin-top: 4px;
            font-size: 10px;
            color: #777;
        }

    /* =========================
           ปุ่มบันทึกผล
           ========================= */

    .week-progress-btn {
        position: absolute;
        top: 7px;
        right: 7px;
        padding: 3px 7px;
        border-radius: 6px;
        background: rgba(255,255,255,.8);
        color: #555;
        font-size: 9px;
        text-decoration: none;
        transition: .2s;
    }

        .week-progress-btn:hover {
            background: white;
            color: #333;
        }

    /* =========================
           Day View
           ========================= */

    .day-calendar {
        width: 100%;
        border-collapse: collapse;
    }

        .day-calendar th {
            background: #f8f8f8;
            color: #666;
            font-weight: 600;
            font-size: 13px;
            padding: 13px;
            text-align: left;
        }

        .day-calendar td {
            padding: 14px 13px;
            border-bottom: 1px solid #f0f0f0;
            color: #555;
            font-size: 14px;
        }

    .day-subject {
        font-weight: 600;
        color: #444;
    }

    /* =========================
           Month View
           ========================= */

    .month-calendar {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        min-width: 900px;
        border-top: 1px solid #eee;
        border-left: 1px solid #eee;
    }

    .month-weekday {
        padding: 10px;
        text-align: center;
        font-size: 12px;
        font-weight: 600;
        color: #777;
        background: #f8f8f8;
        border-right: 1px solid #eee;
        border-bottom: 1px solid #eee;
    }

    .month-day {
        min-height: 110px;
        padding: 8px;
        border-right: 1px solid #eee;
        border-bottom: 1px solid #eee;
        box-sizing: border-box;
    }

    .month-day-number {
        font-size: 12px;
        font-weight: 600;
        color: #666;
        margin-bottom: 5px;
    }

    .month-event {
        background: #e8def8;
        color: #5f4b8b;
        border-radius: 6px;
        padding: 5px 6px;
        margin-bottom: 4px;
        font-size: 10px;
        overflow: hidden;
    }

        .month-event strong {
            display: block;
            font-size: 10px;
        }

        .month-event small {
            font-size: 9px;
            color: #777;
        }

    /* =========================
           Empty
           ========================= */

    .empty-dashboard {
        text-align: center;
        padding: 60px 20px;
        color: #999;
    }

    .empty-dashboard-icon {
        font-size: 40px;
        margin-bottom: 10px;
    }

    .empty-dashboard-title {
        font-size: 16px;
        font-weight: 600;
        color: #777;
    }

    /* =========================
           Responsive
           ========================= */

    @@media (max-width: 900px) {

        .dashboard-page {
            padding: 15px;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .calendar-navigation {
            flex-direction: column;
            gap: 10px;
            align-items: flex-start;
        }
    }

</style>


<div class="dashboard-page">

    <!-- =========================
         Header
         ========================= -->

    <div class="dashboard-header">

        <div class="dashboard-title">

            <h2>
                Smart Study Planner
            </h2>

            <p>
                ภาพรวมตารางอ่านหนังสือของคุณ
            </p>

        </div>

    </div>


    <!-- =========================
         Summary
         ========================= -->

    <div class="summary-grid">

        <div class="summary-card">

            <div class="summary-label">
                กิจกรรมทั้งหมด
            </div>

            <div class="summary-value">
                @ViewBag.TotalActivities
            </div>

            <div class="summary-sub">
                กิจกรรม
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-label">
                จำนวนวิชา
            </div>

            <div class="summary-value">
                @ViewBag.TotalSubjects
            </div>

            <div class="summary-sub">
                วิชา
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-label">
                ชั่วโมงอ่านทั้งหมด
            </div>

            <div class="summary-value">
                @totalHours.ToString("0.##")
            </div>

            <div class="summary-sub">
                ชั่วโมง
            </div>

        </div>

    </div>


    <!-- =========================
         Tabs
         ========================= -->

    <div class="dashboard-tabs">

        <a href="#day"
           class="dashboard-tab"
           id="dayTab">

            รายวัน

        </a>

        <a href="#week"
           class="dashboard-tab active"
           id="weekTab">

            รายสัปดาห์

        </a>

        <a href="#month"
           class="dashboard-tab"
           id="monthTab">

            รายเดือน

        </a>

    </div>


    <!-- =========================
         DAY
         ========================= -->

    <div id="dayView">

        <div class="calendar-navigation">

            <div class="navigation-title">

                @today.ToString(
                         "dddd dd MMMM yyyy",
                         new CultureInfo("th-TH"))

            </div>

            <div class="navigation-buttons">

                <a class="navigation-btn"
                   href="?date=@previousDay.ToString("yyyy-MM-dd")#day">

                    ‹

                </a>

                <a class="navigation-btn"
                   href="?date=@DateTime.Today.ToString("yyyy-MM-dd")#day">

                    วันนี้

                </a>

                <a class="navigation-btn"
                   href="?date=@nextDay.ToString("yyyy-MM-dd")#day">

                    ›

                </a>

            </div>

        </div>

        @if (weekSchedules != null && weekSchedules.Any())
        {
            var activityGroups = weekSchedules
            .Where(x => x.StudyActivity != null)
            .GroupBy(x => new
            {
                x.StudyActivityId,
                ActivityName = x.StudyActivity!.ActivityName,
                Color = x.StudyActivity.Color
            })
            .OrderBy(x => x.Key.ActivityName)
            .ToList();

            <div class="activity-group-summary">

                @foreach (var group in activityGroups)
                {
                    var subjects = group
                    .Select(x => x.SubjectName)
                    .Distinct()
                    .ToList();

                    var hours = group.Sum(x =>
                    (x.EndTime - x.StartTime).TotalHours);

                    <div class="activity-group-card"
                         style="border-left-color:@group.Key.Color;">

                        <div class="activity-group-name">
                            @group.Key.ActivityName
                        </div>

                        <div class="activity-group-subjects">
                            @string.Join(" • ", subjects)
                        </div>

                        <div class="activity-group-hours">
                            @hours.ToString("0.##") ชั่วโมง
                        </div>

                    </div>
                }

            </div>
        }

        <div class="calendar-container">

            @if (todaySchedules != null && todaySchedules.Any())
            {
                <table class="day-calendar">

                    <thead>

                        <tr>

                            <th>
                                เวลา
                            </th>

                            <th>
                                วิชา
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in todaySchedules)
                        {
                            <tr>

                                <td>

                                    @item.StartTime.ToString(@"hh\:mm")
                                    -
                                    @item.EndTime.ToString(@"hh\:mm")

                                </td>

                                <td class="day-subject">

                                    @item.SubjectName

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="empty-Home">

                    <div class="empty-Home-icon">
                        📅
                    </div>

                    <div class="empty-Home-title">
                        วันนี้ยังไม่มีตารางอ่านหนังสือ
                    </div>

                </div>
            }

        </div>

    </div>


    <!-- =========================
         WEEK
         ========================= -->

    <div id="weekView">

        <div class="calendar-navigation">

            <div class="navigation-title">

                @weekStart.ToString("dd/MM/yyyy")
                -
                @weekStart.AddDays(6).ToString("dd/MM/yyyy")

            </div>

            <div class="navigation-buttons">

                <a class="navigation-btn"
                   href="?weekStartDate=@previousWeek.ToString("yyyy-MM-dd")#week">

                    ‹

                </a>

                <a class="navigation-btn"
                   href="?weekStartDate=@DateTime.Today
                       .AddDays(
                           -(7 + ((int)DateTime.Today.DayOfWeek - 1)) % 7)
                       .ToString(" yyyy-MM-dd")#week">

                    วันนี้

                </a>

                <a class="navigation-btn"
                   href="?weekStartDate=@nextWeek.ToString("yyyy-MM-dd")#week">

                    ›

                </a>

            </div>

        </div>


        <div class="calendar-container">

            @if (weekSchedules != null && weekSchedules.Any())
            {
                <div class="week-calendar">

                    <div class="week-header">

                        <div class="week-header-empty">
                        </div>

                        @foreach (var day in days)
                        {
                            <div class="week-day-header">

                                @day.ToString("ddd")

                                <small>
                                    @day.ToString("dd/MM")
                                </small>

                            </div>
                        }

                    </div>


                    <div class="week-body">

                        <div class="week-time-column">

                            @for (
                           int hour = weekStartHour;
                           hour < weekEndHour;
                           hour++
                           )
                            {
                                <div class="week-time-label">

                                    @($"{hour:00}:00 - {(hour + 1):00}")

                                </div>
                            }

                        </div>


                        @foreach (var day in days)
                        {
                            <div class="week-day"
                                 style="
                                    height:@weekCalendarHeight.ToString(
                                        "0.##",
                                        CultureInfo.InvariantCulture)px;
                                         ">

                                @{
                                    var daySchedules =
                                    weekSchedules
                                    .Where(x =>
                                    x.StudyDate.Date == day.Date)
                                    .ToList();
                                }

                                @foreach (var item in daySchedules)
                                {
                                    double top =
                                    (
                                    item.StartTime.TotalHours
                                    - weekStartHour
                                    ) * 70;

                                    double height =
                                    (
                                    item.EndTime
                                    - item.StartTime
                                    ).TotalHours * 70;

                                    var color =
                                    !string.IsNullOrWhiteSpace(item.StudyActivity?.Color)
                                    ? item.StudyActivity.Color
                                    : "#DDE9D5";

                                    <div class="week-event"
                                         style="
                                            top:@top.ToString(
                                                "0.##",
                                                CultureInfo.InvariantCulture)px;

                                            height:@height.ToString(
                                                "0.##",
                                                CultureInfo.InvariantCulture)px;

                                            background:@color;
                                                     ">

                                        <div class="week-event-activity">
                                            @item.StudyActivity?.ActivityName
                                        </div>

                                        <strong>
                                            @item.SubjectName
                                        </strong>

                                        <small>

                                            @item.StartTime.ToString(
                                                     @"hh\:mm")

                                            -

                                            @item.EndTime.ToString(
                                                     @"hh\:mm")

                                        </small>

                                        <!-- เพิ่มเฉพาะปุ่มนี้ -->

                                        <a href="@Url.Action(
                                            "Create",
                                            "StudyProgress",
                                            new { scheduleId = item.Id })"
                                           class="week-progress-btn">

                                            บันทึกผล

                                        </a>

                                    </div>
                                }

                            </div>
                        }

                    </div>

                </div>
            }
            else
            {
                <div class="empty-Home">

                    <div class="empty-Home-icon">
                        📅
                    </div>

                    <div class="empty-Home-title">
                        สัปดาห์นี้ยังไม่มีตารางอ่านหนังสือ
                    </div>

                </div>
            }

        </div>

    </div>


    <!-- =========================
         MONTH
         ========================= -->

    <div id="monthView">

        <div class="calendar-navigation">

            <div class="navigation-title">

                @monthStart.ToString(
                         "MMMM yyyy",
                         new CultureInfo("th-TH"))

            </div>

            <div class="navigation-buttons">

                <a class="navigation-btn"
                   href="?month=@previousMonth.Month&year=@previousMonth.Year#month">

                    ‹

                </a>

                <a class="navigation-btn"
                   href="?month=@DateTime.Today.Month&year=@DateTime.Today.Year#month">

                    วันนี้

                </a>

                <a class="navigation-btn"
                   href="?month=@nextMonth.Month&year=@nextMonth.Year#month">

                    ›

                </a>

            </div>

        </div>


        <div class="calendar-container">

            <div class="month-calendar">

                <div class="month-weekday">
                    จ.
                </div>

                <div class="month-weekday">
                    อ.
                </div>

                <div class="month-weekday">
                    พ.
                </div>

                <div class="month-weekday">
                    พฤ.
                </div>

                <div class="month-weekday">
                    ศ.
                </div>

                <div class="month-weekday">
                    ส.
                </div>

                <div class="month-weekday">
                    อา.
                </div>


                @for (int i = 0; i < firstDayOffset; i++)
                {
                    <div class="month-day"></div>
                }


                @for (
                int dayNumber = 1;
                dayNumber <= daysInMonth;
                dayNumber++
                )
                {
                    var currentDate =
                    new DateTime(
                    monthStart.Year,
                    monthStart.Month,
                    dayNumber);

                    var currentSchedules =
                    monthSchedules
                    .Where(x =>
                    x.StudyDate.Date ==
                    currentDate.Date)
                    .OrderBy(x => x.StartTime)
                    .ToList();

                    <div class="month-day">

                        <div class="month-day-number">

                            @dayNumber

                        </div>

                        @foreach (var item in currentSchedules)
                        {
                            <div class="month-event">

                                <strong>
                                    @item.SubjectName
                                </strong>

                                <small>

                                    @item.StartTime.ToString(
                                             @"hh\:mm")

                                    -

                                    @item.EndTime.ToString(
                                             @"hh\:mm")

                                </small>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const dayTab =
            document.getElementById("dayTab");

        const weekTab =
            document.getElementById("weekTab");

        const monthTab =
            document.getElementById("monthTab");

        const dayView =
            document.getElementById("dayView");

        const weekView =
            document.getElementById("weekView");

        const monthView =
            document.getElementById("monthView");


        function showView(view) {

            dayView.style.display = "none";

            weekView.style.display = "none";

            monthView.style.display = "none";

            dayTab.classList.remove("active");

            weekTab.classList.remove("active");

            monthTab.classList.remove("active");


            if (view === "day") {

                dayView.style.display = "block";

                dayTab.classList.add("active");

            }
            else if (view === "month") {

                monthView.style.display = "block";

                monthTab.classList.add("active");

            }
            else {

                weekView.style.display = "block";

                weekTab.classList.add("active");

            }

            window.location.hash = view;
        }


        dayTab.addEventListener("click", function (e) {

            e.preventDefault();

            showView("day");

        });


        weekTab.addEventListener("click", function (e) {

            e.preventDefault();

            showView("week");

        });


        monthTab.addEventListener("click", function (e) {

            e.preventDefault();

            showView("month");

        });


        const hash =
            window.location.hash.replace("#", "");


        if (
            hash === "day" ||
            hash === "month"
        ) {

            showView(hash);

        }
        else {

            showView("week");

        }

    });

</script>